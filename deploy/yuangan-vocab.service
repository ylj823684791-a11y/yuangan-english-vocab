[Unit]
Description=Yuangan English Vocab API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/yuangan-vocab/server
Environment=YG_HOST=127.0.0.1
Environment=YG_PORT=3001
Environment=YG_DATA=/opt/yuangan-vocab/server/data
ExecStart=/usr/bin/python3 /opt/yuangan-vocab/server/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
